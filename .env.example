# ──────────────────────────────────────────────────────────────────────────────
# Multi-LLM Evaluation Platform — environment template
# Copy to `.env` and fill in values. `.env` is gitignored; never commit real keys.
# Every variable here is read on the server only (src/server/env.ts).
# ──────────────────────────────────────────────────────────────────────────────

# Public base URL of the app (used for OpenRouter attribution headers).
APP_URL=http://localhost:3000

# ── Database (PostgreSQL, e.g. Neon) ─────────────────────────────────────────
# Pooled connection string, used by the app at runtime (Neon: the "-pooler" host).
DATABASE_URL=
# Direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_DATABASE_URL=
# Optional separate database/branch for DB integration tests (skipped when empty).
TEST_DATABASE_URL=
# Optional runtime pool size (default 10). Use 1 for single-connection servers like `prisma dev`.
DATABASE_POOL_MAX=

# ── Redis (optional; in-memory fallback when unset) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── LLM provider API keys (a provider is offered only when its key is set) ───
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# https://huggingface.co/settings/tokens (fine-grained, "Make calls to Inference Providers")
HUGGINGFACE_API_KEY=

# ── Model lists (optional, comma-separated; replace the built-in defaults) ───
GROQ_MODELS=
GEMINI_MODELS=
OPENROUTER_MODELS=
HUGGINGFACE_MODELS=
# Only offer OpenRouter models that are free (":free" / zero pricing). Default: true
OPENROUTER_FREE_ONLY=true

# ── LLM-as-a-judge ───────────────────────────────────────────────────────────
# Format: <provider>:<model-id>
JUDGE_MODEL=gemini:gemini-3.8-flash
# Tried in order when the primary judge fails or returns invalid output.
JUDGE_FALLBACK_MODELS=groq:openai/gpt-oss-120b,openrouter:google/gemma-4-31b-it:free
# Max concurrent judge calls (keeps free-tier rate limits happy).
JUDGE_CONCURRENCY=2
# Output budget per judge call (thinking models spend part of it on reasoning).
JUDGE_MAX_TOKENS=3000

# ── Behaviour ────────────────────────────────────────────────────────────────
# Deterministic demo models for development/testing. Default: on outside production.
ENABLE_DEMO_PROVIDER=
# Per-call timeout and retry budget for model requests.
MODEL_TIMEOUT_MS=45000
MODEL_MAX_RETRIES=2
# Cache identical model/judge requests (0 = disabled).
RESPONSE_CACHE_TTL_SECONDS=0
